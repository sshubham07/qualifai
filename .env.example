# ---- App
QUALIFAI_ENV=local
QUALIFAI_SECRET_KEY=change-me
QUALIFAI_BASE_URL=http://localhost:3000

# ---- Datastores
QUALIFAI_DATABASE_URL=postgresql+asyncpg://qualifai:qualifai@localhost:5432/qualifai
QUALIFAI_REDIS_URL=redis://localhost:6379/0
QUALIFAI_S3_ENDPOINT=http://localhost:9000
QUALIFAI_S3_BUCKET=qualifai
QUALIFAI_S3_ACCESS_KEY=minio
QUALIFAI_S3_SECRET_KEY=minio12345

# ---- LLM providers (all OpenAI-compatible). Task -> model routing lives in content/models.yaml
QUALIFAI_OLLAMA_BASE_URL=http://localhost:11434/v1
QUALIFAI_GROQ_BASE_URL=https://api.groq.com/openai/v1
QUALIFAI_GROQ_API_KEY=
QUALIFAI_VLLM_BASE_URL=

# ---- Email (Mailpit locally: UI on http://localhost:8025)
QUALIFAI_SMTP_HOST=localhost
QUALIFAI_SMTP_PORT=1025
QUALIFAI_MAIL_FROM=QualifAI <no-reply@qualifai.local>

# ---- Retention
QUALIFAI_KIT_TTL_DAYS=7
QUALIFAI_REPORT_RETENTION_DAYS=90
